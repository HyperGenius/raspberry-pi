{
  "uid": "${uid}",
  "title": "Raspberry Pi",
  "description": "roles/alloy が送るメトリクス（terraform/grafana-cloud で管理。画面で変更しても次の apply で戻る）",
  "tags": [
    "raspberry-pi"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "ホスト",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource_uid}"
        },
        "query": {
          "query": "label_values(node_uname_info{job=\"${job}\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(node_uname_info{job=\"${job}\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "CPU 使用率",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_uid}"
          },
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"${job}\",instance=\"$instance\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "CPU",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "メモリ使用率",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_uid}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_uid}"
          },
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"${job}\",instance=\"$instance\"} / node_memory_MemTotal_bytes{job=\"${job}\",instance=\"$instance\"})",
          "legendFormat": "メモリ",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": ${memory_used_percent_max}
              }
            ]
          },
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "description": "1 - MemAvailable / MemTotal。赤はアラートのしきい値（使えるメモリ）"
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "CPU の温度",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_uid}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_uid}"
          },
          "refId": "A",
          "expr": "node_thermal_zone_temp{job=\"${job}\",instance=\"$instance\",type=\"cpu-thermal\"}",
          "legendFormat": "CPU",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": ${cpu_temp_celsius}
              }
            ]
          },
          "min": 30,
          "max": 90,
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "description": "赤はアラートのしきい値"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "低電圧",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_uid}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_uid}"
          },
          "refId": "A",
          "expr": "max_over_time(node_hwmon_in_lcrit_alarm_volts{job=\"${job}\",instance=\"$instance\",chip=\"soc:firmware_raspberrypi_hwmon\"}[$__range])",
          "legendFormat": "低電圧",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "なし",
                  "index": 0
                },
                "1": {
                  "text": "検知",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "表示している期間に低電圧の警告（rpi_volt）があったか"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU 使用率",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_uid}"
          },
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"${job}\",instance=\"$instance\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "CPU",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "メモリ使用率",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_uid}"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_uid}"
          },
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"${job}\",instance=\"$instance\"} / node_memory_MemTotal_bytes{job=\"${job}\",instance=\"$instance\"})",
          "legendFormat": "メモリ",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": ${memory_used_percent_max}
              }
            ]
          },
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU の温度",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_uid}"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_uid}"
          },
          "refId": "A",
          "expr": "node_thermal_zone_temp{job=\"${job}\",instance=\"$instance\",type=\"cpu-thermal\"}",
          "legendFormat": "CPU",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": ${cpu_temp_celsius}
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "ストレージ使用率",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_uid}"
          },
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"${job}\",instance=\"$instance\"} / node_filesystem_size_bytes{job=\"${job}\",instance=\"$instance\"})",
          "legendFormat": "{{mountpoint}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": ${disk_used_percent_max}
              }
            ]
          },
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "valueMode": "color",
        "namePlacement": "left"
      },
      "description": "1 - avail / size（root 用の予約領域は使用中として数える）。赤はアラートのしきい値（空き容量）"
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "空き容量",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_uid}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_uid}"
          },
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{job=\"${job}\",instance=\"$instance\"}",
          "legendFormat": "{{mountpoint}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "min": 0,
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "valueMode": "color",
        "namePlacement": "left"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "空き容量の推移",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_uid}"
          },
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{job=\"${job}\",instance=\"$instance\"}",
          "legendFormat": "{{mountpoint}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "off"
            },
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "マウントの状態",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_uid}"
          },
          "refId": "A",
          "expr": "node_filesystem_readonly{job=\"${job}\",instance=\"$instance\"}",
          "legendFormat": "{{mountpoint}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "読み書き",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "読み取り専用",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "insertNulls": 180000
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "空白はマウントされていない（メトリクスが届かない）期間。マウント先は roles/alloy の alloy_filesystem_mount_points"
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "サービスの状態",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_uid}"
      },
      "gridPos": {
        "x": 8,
        "y": 29,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_uid}"
          },
          "refId": "A",
          "expr": "node_systemd_unit_state{job=\"${job}\",instance=\"$instance\",state=\"active\"} + ignoring (state) (2 * node_systemd_unit_state{job=\"${job}\",instance=\"$instance\",state=\"activating\"}) + ignoring (state) (3 * node_systemd_unit_state{job=\"${job}\",instance=\"$instance\",state=\"failed\"})",
          "legendFormat": "{{name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "停止",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "稼働",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "起動中",
                  "color": "yellow",
                  "index": 2
                },
                "3": {
                  "text": "失敗",
                  "color": "dark-red",
                  "index": 3
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "insertNulls": 180000
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "docker compose を起動する unit（roles/alloy の alloy_compose_units）。停止は inactive / deactivating"
    },
    {
      "id": 13,
      "type": "state-timeline",
      "title": "コンテナの状態",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_uid}"
      },
      "gridPos": {
        "x": 16,
        "y": 29,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_uid}"
          },
          "refId": "A",
          "expr": "compose_container_up{job=\"${job}\",instance=\"$instance\"} + 2 * compose_container_unhealthy{job=\"${job}\",instance=\"$instance\"}",
          "legendFormat": "{{container}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "停止",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "稼働",
                  "color": "green",
                  "index": 1
                },
                "3": {
                  "text": "unhealthy",
                  "color": "orange",
                  "index": 2
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "insertNulls": 180000
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "compose ファイルにあるコンテナ（compose-metrics.timer が 1 分ごとに書き出す）。停止は compose down で削除された場合を含む"
    }
  ]
}
