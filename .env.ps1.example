# Copy this file to .env.ps1 (git-ignored) and fill in the values.
$env:EPGSTATION_BASE_URL = 'http://192.168.10.55:8888'
$env:SFTPGO_BASE_URL     = 'http://192.168.10.55:8080'
$env:SFTPGO_USER         = 'genius'
$env:SFTPGO_PASSWORD     = ''
$env:SFTPGO_REMOTE_DIR   = '/data'   # optional (default /data; '/recorded' with encoder and -DeleteAfterCopy)
$env:RECORDINGS_DEST_DIR = 'D:\Recordings'
$env:COPY_RECORDINGS_DATA_DIR = ''   # optional: log and metrics folder (default %ProgramData%\CopyRecordings)

# Install-Alloy.ps1 only (Grafana Cloud; the token needs metrics:write and logs:write only)
$env:GRAFANA_CLOUD_PROMETHEUS_URL      = 'https://prometheus-prod-XX-prod-XX.grafana.net/api/prom/push'
$env:GRAFANA_CLOUD_PROMETHEUS_USERNAME = ''
$env:GRAFANA_CLOUD_LOKI_URL            = 'https://logs-prod-XXX.grafana.net/loki/api/v1/push'
$env:GRAFANA_CLOUD_LOKI_USERNAME       = ''
$env:GRAFANA_CLOUD_TOKEN               = ''

# Add-EncodeTasks.ps1 (Amatsukaze). Save .env.ps1 as UTF-8 with BOM if a value contains Japanese.
$env:ENCODE_OUTPUT_DIR   = 'D:\Encoded'
$env:ENCODE_RECORDED_DIR = 'E:\RaspberryPi_recorded'   # optional (default shown)
$env:AMATSUKAZE_DIR      = 'C:\ProgramData\Amatsukaze' # optional (default shown)
$env:ENCODE_PROFILE_MAP  = ''   # optional (default windows\amatsukaze\encode-profiles.csv)
$env:ENCODE_DATA_DIR     = ''   # optional: log folder (default %ProgramData%\EncodeRecordings)
