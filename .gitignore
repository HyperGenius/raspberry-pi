*.retry
.vault_pass*
*.secret.yml
.DS_Store

# ansible-vault の秘密情報（公開リポジトリのため暗号化済みでも含めない）
vault.yml

# Terraform（state・tfvars に Grafana Cloud のトークンや Slack の Webhook URL が含まれる。.terraform.lock.hcl はコミットする）
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfvars
crash.log

# Python のバイトコード（roles/*/files のスクリプトの構文チェックで作られる）
__pycache__/

# 録画のコピー用スクリプトの認証情報・フォルダ名（.env.ps1.example をコピーして作る）
.env.ps1
