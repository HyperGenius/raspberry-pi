# {{ ansible_managed }}
# Plex Media Server（docker compose）。USB（nofail）がマウントされていなければ起動しない（SD カードに DB を作らない）
[Unit]
Description=Plex Media Server (docker compose)
Requires=docker.service
After=docker.service
RequiresMountsFor={{ ([plex_data_dir] + plex_media_dirs | map(attribute='source') | list) | join(' ') }}

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ plex_dir }}
# イメージは Ansible が取得する（起動時にネットワークに依存しない）
ExecStart=/usr/bin/docker compose up --detach --wait --pull never --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
